# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for the web app (and Expo web)
CORS_ORIGINS=http://localhost:4000,http://localhost:8081,http://localhost:19006

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/eventique
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/eventique
MONGO_URI=mongodb://127.0.0.1:27017/eventique

# ---- Auth ----
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ---- OTP ----
# dev    = no SMS is sent; the code is printed in the server log and returned in the API response (testing only)
# msg91  = send SMS through MSG91 (needs MSG91_AUTH_KEY + MSG91_TEMPLATE_ID)
# twilio = send SMS through Twilio (needs TWILIO_SID + TWILIO_TOKEN + TWILIO_FROM)
OTP_PROVIDER=dev
# Demo phone numbers that always accept DEMO_OTP (leave empty in production)
DEMO_PHONES=9876543210,9123456780,9000000001
DEMO_OTP=123456
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Code needed to sign up as an admin
ADMIN_INVITE_CODE=EVQ-ADMIN

# ---- Payments (Razorpay) ----
# Get TEST keys from https://dashboard.razorpay.com -> Settings -> API Keys (Test Mode)
# If left empty, the server uses a built-in "mock" gateway so the full flow still works locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Image storage ----
# local = save files to ./uploads (served at /uploads)
# cloudinary = upload to Cloudinary (needs CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>)
STORAGE=local
CLOUDINARY_URL=
PUBLIC_URL=http://localhost:4000

# ---- Platform defaults ----
COMMISSION_PERCENT=8
GST_PERCENT=18
ADVANCE_PERCENT=20
FREE_CANCEL_HOURS=72

# ---- Optional: 22-language translation (Anthropic API) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
